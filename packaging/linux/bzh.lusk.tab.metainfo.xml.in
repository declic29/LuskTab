<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>bzh.lusk.tab</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Lusk Tab</name>
  <summary>Calculate, analyse and chart data in workbooks; open and save Excel files</summary>
  <summary xml:lang="fr">Calculer, analyser et représenter des données ; ouvrir et enregistrer des fichiers Excel</summary>
  <developer id="bzh.lusk">
    <name>Lusk (association loi 1901)</name>
  </developer>
  <description>
    <p>
      Lusk Tab is a free, open-source spreadsheet published by the Lusk association. It opens and saves .xlsx workbooks and CSV/TSV files, evaluates hundreds of worksheet functions, and formats, sorts, filters and charts your data. Your workbooks stay on your computer.
    </p>
    <p xml:lang="fr">
      Lusk Tab est un tableur libre et gratuit, publié par l'association Lusk. Il ouvre et enregistre les classeurs .xlsx et les fichiers CSV/TSV, calcule des centaines de fonctions, met en forme, trie, filtre et représente vos données en graphiques. Vos classeurs restent sur votre ordinateur.
    </p>
  </description>
  <launchable type="desktop-id">bzh.lusk.tab.desktop</launchable>
  <icon type="stock">bzh.lusk.tab</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://www.lusk.bzh</url>
  <url type="bugtracker">https://github.com/declic29/LuskTab/issues</url>
  <url type="help">https://github.com/declic29/LuskTab</url>
  <categories>
    <category>Office</category>
    <category>Spreadsheet</category>
  </categories>
  <keywords>
    <keyword>spreadsheet</keyword>
    <keyword>workbook</keyword>
    <keyword>formula</keyword>
    <keyword>xlsx</keyword>
    <keyword>csv</keyword>
    <keyword xml:lang="fr">tableur</keyword>
    <keyword xml:lang="fr">classeur</keyword>
  </keywords>
  <!-- Lusk Tab green (#7bc143), as on the left bar of the app. -->
  <branding>
    <color type="primary" scheme_preference="light">#cfe9b4</color>
    <color type="primary" scheme_preference="dark">#4c7d26</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>gridcraft</binary>
    <binary>gridcraft-cli</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</mediatype>
    <mediatype>application/vnd.ms-excel.sheet.macroEnabled.12</mediatype>
    <mediatype>application/vnd.ms-excel.sheet.binary.macroEnabled.12</mediatype>
    <mediatype>application/vnd.oasis.opendocument.spreadsheet</mediatype>
    <mediatype>text/csv</mediatype>
    <mediatype>text/tab-separated-values</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
