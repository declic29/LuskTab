<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <!-- Lusk Tab (repris de Lusk Texte) : l'installateur en français, aux couleurs de Lusk. Un nouveau
       produit (UpgradeCode à lui), qui ne remplace ni GridCraft ni Lusk Texte. -->
  <Package Name="Lusk Tab" Manufacturer="Lusk" Version="$(var.Version)" UpgradeCode="59E39F09-9F0F-494C-96BD-06E3C9EBCCFE" Scope="perUserOrMachine" Compressed="yes" Language="1036" Codepage="1252">
    <SummaryInformation Description="Lusk Tab, tableur" Manufacturer="Lusk" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Une version plus récente de Lusk Tab est déjà installée." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="GridcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="GridcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.lusk.bzh" />
    <Property Id="ARPURLUPDATEINFO" Value="https://www.lusk.bzh" />
    <Property Id="ARPHELPLINK" Value="https://github.com/declic29/LuskTab" />

    <!-- Installer UI, in French (wix build -culture fr-FR, plus lusk-fr.wxl): WixUI_Minimal,
         whose welcome page is replaced by Lusk's own (lusk-welcome.wxs: license, acceptance,
         desktop shortcut), then progress and a finish page so people can see the install worked.
         The bitmaps (logo and fox) come from images/generate.py; package.ps1 builds the license
         RTF from LICENSE-MIT and LICENSE-APACHE. The finish page offers to launch Lusk Tab
         (ticked by default) through WixShellExec (WixToolset.Util.wixext); silent installs (/qn)
         never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)images\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)images\dialog.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Lancer Lusk Tab" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#GridcraftExe]" />
    <CustomAction Id="LaunchGridcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <UIRef Id="LuskWelcome" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchGridcraft" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Lusk">
        <Directory Id="INSTALLFOLDER" Name="Lusk Tab" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Desktop shortcut: ticked by default on the welcome page. An update keeps the earlier
         choice: a copy installed without the shortcut (no DesktopShortcut value under
         Software\LuskTab) gets none again. Silent installs: LUSKDESKTOP=0 leaves it out. -->
    <Property Id="LUSK_DESKTOP_U" Secure="yes"><RegistrySearch Id="LuskDesktopUSearch" Root="HKCU" Key="Software\LuskTab" Name="DesktopShortcut" Type="raw" /></Property>
    <Property Id="LUSK_DESKTOP_M" Secure="yes"><RegistrySearch Id="LuskDesktopMSearch" Root="HKLM" Key="Software\LuskTab" Name="DesktopShortcut" Type="raw" /></Property>
    <SetProperty Id="LUSKDESKTOP" Action="LuskDesktopDefault" Value="1" After="AppSearch" Sequence="first" Condition="NOT LUSKDESKTOP AND (LUSK_DESKTOP_U OR LUSK_DESKTOP_M OR NOT (CRAFT_U_DIR OR CRAFT_M_DIR))" />
    <Property Id="LUSKDESKTOP" Secure="yes" />

    <Feature Id="Main" Title="Lusk Tab" Level="1">
      <ComponentGroupRef Id="AppNotices" />
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="GridcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppNotices" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppNoticesDir)\**" />
    </ComponentGroup>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="GridcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="GridcraftApp" Guid="4D45679F-41EA-47B3-AD8E-7A4D4A94C50D">
        <File Id="GridcraftExe" Source="$(var.BinDir)\gridcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Lusk Tab" Description="Lusk Tab, tableur" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="GridcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\gridcraft.exe" Value="[#GridcraftExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\LuskTab" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- File associations. Each spreadsheet type gets a Lusk Tab ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so Lusk Tab shows in
           Explorer's "Open with". The types Lusk Tab opens as workbooks are also its Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user makes
           it the default. Nothing here sets an extension's default: the installer never takes
           over .xlsx from another app. .xlsb (data import) is only an "Open with" candidate.
           Removed again on uninstall. -->
      <Component Id="GridcraftFileTypes" Guid="0D5A012B-C681-4B2D-B4E6-3D3E58851567">
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="LuskTab" Value="Software\LuskTab\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab\Capabilities" Name="ApplicationName" Value="Lusk Tab" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab\Capabilities" Name="ApplicationDescription" Value="Le tableur libre de l'association Lusk ; ouvrez et enregistrez des classeurs Excel et des fichiers CSV." Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab\Capabilities" Name="ApplicationIcon" Value="&quot;[#GridcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\gridcraft.exe" Name="FriendlyAppName" Value="Lusk Tab" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\gridcraft.exe\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="LuskTab.Workbook" Description="Classeur Excel" Icon="GridcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskTab.Workbook\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsx\OpenWithProgids" Name="LuskTab.Workbook" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\gridcraft.exe\SupportedTypes" Name=".xlsx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab\Capabilities\FileAssociations" Name=".xlsx" Value="LuskTab.Workbook" Type="string" />

        <ProgId Id="LuskTab.WorkbookMacroEnabled" Description="Classeur Excel prenant en charge les macros" Icon="GridcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskTab.WorkbookMacroEnabled\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsm\OpenWithProgids" Name="LuskTab.WorkbookMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\gridcraft.exe\SupportedTypes" Name=".xlsm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab\Capabilities\FileAssociations" Name=".xlsm" Value="LuskTab.WorkbookMacroEnabled" Type="string" />

        <ProgId Id="LuskTab.LegacyWorkbook" Description="Classeur Excel 97-2003" Icon="GridcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskTab.LegacyWorkbook\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xls\OpenWithProgids" Name="LuskTab.LegacyWorkbook" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\gridcraft.exe\SupportedTypes" Name=".xls" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab\Capabilities\FileAssociations" Name=".xls" Value="LuskTab.LegacyWorkbook" Type="string" />

        <ProgId Id="LuskTab.BinaryWorkbook" Description="Classeur binaire Excel" Icon="GridcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskTab.BinaryWorkbook\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsb\OpenWithProgids" Name="LuskTab.BinaryWorkbook" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\gridcraft.exe\SupportedTypes" Name=".xlsb" Value="" Type="string" />

        <ProgId Id="LuskTab.OpenDocumentSpreadsheet" Description="Feuille de calcul OpenDocument" Icon="GridcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskTab.OpenDocumentSpreadsheet\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ods\OpenWithProgids" Name="LuskTab.OpenDocumentSpreadsheet" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\gridcraft.exe\SupportedTypes" Name=".ods" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab\Capabilities\FileAssociations" Name=".ods" Value="LuskTab.OpenDocumentSpreadsheet" Type="string" />

        <ProgId Id="LuskTab.Csv" Description="Fichier CSV (séparateur : virgule)" Icon="GridcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskTab.Csv\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.csv\OpenWithProgids" Name="LuskTab.Csv" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\gridcraft.exe\SupportedTypes" Name=".csv" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab\Capabilities\FileAssociations" Name=".csv" Value="LuskTab.Csv" Type="string" />

        <ProgId Id="LuskTab.Tsv" Description="Texte séparé par des tabulations" Icon="GridcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskTab.Tsv\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tsv\OpenWithProgids" Name="LuskTab.Tsv" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\gridcraft.exe\SupportedTypes" Name=".tsv" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab\Capabilities\FileAssociations" Name=".tsv" Value="LuskTab.Tsv" Type="string" />
      </Component>

      <Component Id="LuskDesktopShortcut" Directory="DesktopFolder" Guid="F48362DD-0C25-412B-A034-7F9E134259D6" Condition="LUSKDESKTOP = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="Lusk Tab" Description="Lusk Tab, tableur" Target="[#GridcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="GridcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\LuskTab" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>

      <Component Id="GridcraftCli">
        <File Id="GridcraftCliExe" Source="$(var.BinDir)\gridcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
