<?xml version="1.0" encoding="utf-8"?>
<!-- Lusk Tab's own wording for WiX's French installer pages (wix build -culture fr-FR). -->
<WixLocalization Culture="fr-FR" Codepage="1252" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}Lusk Tab est installé" />
  <String Id="ExitDialogDescription" Value="Merci d'avoir choisi Lusk Tab, le tableur libre de l'association Lusk. Cliquez sur Terminer pour fermer l'assistant." />
</WixLocalization>
